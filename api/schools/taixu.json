  "bridges_label": "佛儒道之徑",
  "bridges_rujia": [
    {
      "title": "慈悲 ↔ 仁 ↔ 慈",
      "from": "佛·慈悲",
      "to": "儒·仁／道·慈",
      "from_slug": "",
      "to_slug": "",
      "note": "佛之慈悲，四無量之首——慈與樂、悲拔苦；儒之仁，「愛人」為本；道之慈，三寶之首「慈故能勇」。三者皆以「己欲」推及「他者」，然佛以眾生平等、儒以親親為差、道以自然為本——發心同而階次異。"
    },
    {
      "title": "緣起性空 ↔ 易之變 ↔ 道之玄",
      "from": "佛·緣起性空",
      "to": "易·變易／道·玄同",
      "from_slug": "",
      "to_slug": "",
      "note": "《中論》「眾因緣生法，我說即是空」——萬法依緣，無有自性；《易》「窮則變，變則通」——陰陽流轉，無有定體；《老》「同謂之玄」——有無相生，本末一致。三家皆觀變化之相，而歸無住之本。"
    },
    {
      "title": "無我 ↔ 吾喪我 ↔ 克己",
      "from": "佛·無我",
      "to": "莊·吾喪我／論·克己復禮",
      "from_slug": "",
      "to_slug": "坐忘",
      "note": "《南華·齊物》「今者吾喪我」——忘形離知；孔子「克己復禮為仁」——減損私執；佛家「無我」——五蘊非我。三者皆作減法，皆欲去執，而所立之「本」異——佛立法性、道立自然、儒立禮義。"
    },
    {
      "title": "菩提心 ↔ 惻隱之心",
      "from": "佛·菩提心",
      "to": "孟·惻隱之心",
      "from_slug": "",
      "to_slug": "",
      "note": "《華嚴》「發阿耨多羅三藐三菩提心」——為度眾生願成佛；孟子「見孺子將入於井，皆有怵惕惻隱之心」——不忍之根本。二者皆指人心本有之善端——佛以之為成佛之因，儒以之為仁政之始。"
    },
    {
      "title": "人間佛教 ↔ 下學上達",
      "from": "太虛·人間佛教",
      "to": "孔子·下學而上達",
      "from_slug": "",
      "to_slug": "",
      "note": "太虛曰「人成即佛成」——不假他方淨土，於人世完人格即成佛陀；孔子曰「下學而上達」——從灑掃應對中通天命之微。二者皆反對離世求道——佛不求淨土於他方，儒不求聖境於天外。"
    }
  ],
