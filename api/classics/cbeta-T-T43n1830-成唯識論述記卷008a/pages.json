1830_p0513a01","n":"0513a","t":"生彼第八現行相見分種也第"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0513c01","n":"0513c","t":"證如相與見能為二緣自證與"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0514a01","n":"0514a","t":"不別變其見分自緣等亦更別"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0514c01","n":"0514c","t":"辨生現種分別等後總結或從"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0515a01","n":"0515a","t":"住一境界不移動故又復移轉"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0515b01","n":"0515b","t":"知何意眷屬亦說名業述曰以"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0516a01","n":"0516a","t":"記親生之種此中二取通七識"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0516c01","n":"0516c","t":"外之緣方得生死相續此結答"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0517a01","n":"0517a","t":"用為緣而熏故立表義名言熏"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0517b01","n":"0517b","t":"有支者因義分義即三有因生"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0517c01","n":"0517c","t":"此即別解三習氣已下配屬頌"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0518a01","n":"0518a","t":"諸福行彼信為依乃造斯行由"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0518b01","n":"0518b","t":"可知也然於此中惑業苦攝一"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0518c01","n":"0518c","t":"無明支故唯取無明不取餘法"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0519a01","n":"0519a","t":"逐非餘七識諸種所隨故此論"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0519b01","n":"0519b","t":"一者一切有漏五蘊皆是此體"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0519c01","n":"0519c","t":"若約當生分位說者即名色支"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0520a01","n":"0520a","t":"答下自會言雖取支中攝諸煩"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0520b01","n":"0520b","t":"起宣說展轉傳說故名緣起此"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0520c01","n":"0520c","t":"是老義滅無義是死義前是異"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0521a01","n":"0521a","t":"了疑也二與行作因同前對法"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1830_p0521b01","n":"0521b","t":"是既問答已乃至老死問答皆"},{"h":"https://cbetaon