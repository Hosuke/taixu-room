1804_p0053b01","n":"0053b","t":"若作偏局一向不合故多論云"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0053c01","n":"0053c","t":"不得戒於非所能境云何得戒"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0054a01","n":"0054a","t":"貪等三善根及身口二護一戒"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0054b01","n":"0054b","t":"種類所說又云攝戒不盡以罪"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0054c01","n":"0054c","t":"今約戒本人並誦持文相易明"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0055a01","n":"0055a","t":"火中是不染之相問此淫戒結"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0055b01","n":"0055b","t":"善見云子作惡事父母逐去後"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0055c01","n":"0055c","t":"上掃土淨地棄之不得惡用摩"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0056a01","n":"0056a","t":"分此一向準入重攝二者十方"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0056b01","n":"0056b","t":"互就初中如僧祇寺主摩摩帝"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0056c01","n":"0056c","t":"果者使人取啖大木供僧椽梁"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0057a01","n":"0057a","t":"作鳥獸形得罪除在佛前為供"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0057b01","n":"0057b","t":"時言施佛者則色身受用言施"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0057c01","n":"0057c","t":"迴改餘三得不準上可知三明"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0058a01","n":"0058a","t":"識達俗士須說福食難消非為"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0058b01","n":"0058b","t":"勤掌錄為賊所偷者守物比丘"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0058c01","n":"0058c","t":"師奪弟子將來得重四賊施比"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0059a01","n":"0059a","t":"病者心緣即差得直方示得直"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0059b01","n":"0059b","t":"種盜心謂苦切取輕慢取以他"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0059c01","n":"0059c","t":"諸師盛行多依十誦彼云盜五"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0060a01","n":"0060a","t":"法判用僧物之類善見云畫地"},{"h":"https://cbetaonline.dila.edu.tw/zh/T40n1804_p0060b01","n":"0060b","t":"如此以準上列猶恐不肖者謂"},{"h":"https://cbetaon