1797_p0797a01","n":"0797a","t":"羅於除障中最為第一真實之"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0797b01","n":"0797b","t":"所出稱機之用爾時一切大眾"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0797c01","n":"0797c","t":"爼壞也爾時世尊作如是念我"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0798a01","n":"0798a","t":"聲云唅也佉是大空上加點轉"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0798b01","n":"0798b","t":"是已成萬德訶字即是法幢旗"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0798c01","n":"0798c","t":"方諸佛共護持故猶如金剛城"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0799a01","n":"0799a","t":"此品來也三宗趣者盡心供養"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0799b01","n":"0799b","t":"將能破怨敵故又訶字是菩提"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0799c01","n":"0799c","t":"繞者化主所坐右三頌現阿字"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0800a01","n":"0800a","t":"能生此藏能生一切佛事也如"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0800b01","n":"0800b","t":"遍一切也閻浮金色者從閻浮"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0800c01","n":"0800c","t":"故以文殊師利菩薩佛次說耶"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0801a01","n":"0801a","t":"也訶是喜義亦是行義也盧有"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0801b01","n":"0801b","t":"也現事嚴備可知以本真言印"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0801c01","n":"0801c","t":"有遮聲是生死謂離生死上有"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0802a01","n":"0802a","t":"得也摩訶引昧怛𭌆也三合大"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0802b01","n":"0802b","t":"中大界謂從初發大菩提心乃"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0802c01","n":"0802c","t":"庾蘖帝是生義所謂大慈生也"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0803a01","n":"0803a","t":"聲喧聒令聽聞者心不寂靜次"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0803b01","n":"0803b","t":"當也普入諸趣中者入者趣入"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0803c01","n":"0803c","t":"誦也法則者能持因心也所得"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0804a01","n":"0804a","t":"珠初起念誦即時也今者上時"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0804b01","n":"0804b","t":"身也普通種子心真言門迦字"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0804c01","n":"0804c","t":"心也從此心起者初阿字心起"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0805a01","n":"0805a","t":"如是遍於一切法義之中也所"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0805b01","n":"0805b","t":"一頌明字色并所安處此中用"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0805c01","n":"0805c","t":"而得自在等於虛空能為一切"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0806a01","n":"0806a","t":"也北面等八句廣釋悉地作用"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0806b01","n":"0806b","t":"門四從又應如前乃至無有異"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0806c01","n":"0806c","t":"種光光中現是諸法門真言也"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0807a01","n":"0807a","t":"損其行者床上亦得然者不得"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0807b01","n":"0807b","t":"降此三毒名降三世又如由過"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1797_p0807c01","n":"0807c","t":"人故現相法次一句非但有相"}],"scheme":"cbeta","slug":"cbeta-T-T39n1797-大毘盧遮那經供養次第法疏","source":"CBETA T39n1797 @ xml-p5 dbdea41","total":54,"unit":"T39 頁欄"}