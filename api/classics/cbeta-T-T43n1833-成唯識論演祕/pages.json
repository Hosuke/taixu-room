//cbetaonline.dila.edu.tw/zh/T43n1833_p0894c01","n":"0894c","t":"復恒轉而不自依證八無依問"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0895a01","n":"0895a","t":"種造五根者後即造彼扶塵四"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0895b01","n":"0895b","t":"所名有所依即恐心所亦是所"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0895c01","n":"0895c","t":"續故若遇勝境率爾心後相續"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0896a01","n":"0896a","t":"增意憤增故從彼處沒又按對"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0896b01","n":"0896b","t":"故詳曰乍觀論勢誠有斯理若"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0897a01","n":"0897a","t":"前色種子能生今色理不得成"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0897c01","n":"0897c","t":"云何斷惑成阿羅漢何所以者"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0898a01","n":"0898a","t":"四煩惱恒相應謂我見我愛我"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0898b01","n":"0898b","t":"攝論第二云非彼種子有別實"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0898c01","n":"0898c","t":"不緣當須分別分別可知有漏"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0899a01","n":"0899a","t":"性唯有一相所謂非相非相即"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0899b01","n":"0899b","t":"念念壞二有漏故對治壞唯苦"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0899c01","n":"0899c","t":"即通名八識皆有此三名故若"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0900c01","n":"0900c","t":"流識等境之類也過去本質雖"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0901a01","n":"0901a","t":"外難意云若緣事疑是煩惱者"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0901c01","n":"0901c","t":"者有情所歸所集之所猶彼市"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0902a01","n":"0902a","t":"世道先斷一切薩迦耶見後能"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0902b01","n":"0902b","t":"耶答俱有依中含共不共聖道"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0902c01","n":"0902c","t":"犯不定所立別宗復違比量之"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0903a01","n":"0903a","t":"緣何失若要起執方名賴耶既"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0903b01","n":"0903b","t":"略引學者猶迷故今具錄論云"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0903c01","n":"0903c","t":"為能治因故故出世善亦不得"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0904a01","n":"0904a","t":"等相應應名不共故今對顯二"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0904b01","n":"0904b","t":"自名處是宗法也又總是喻更"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0904c01","n":"0904c","t":"無義能持無義故皆名法由彼"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0905a01","n":"0905a","t":"及心法俱滅何異按無性攝論"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0905b01","n":"0905b","t":"種子執受所依所攝阿賴耶識"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0905c01","n":"0905c","t":"於六境了別名識不言有境而"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0906a01","n":"0906a","t":"顯示現受生化謂現化身於天"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0906b01","n":"0906b","t":"諸放逸讚不放逸又復建立隨"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0906c01","n":"0906c","t":"受相應思能起化故名化意業"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0907a01","n":"0907a","t":"利或名六衰能衰有情所有善"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0907b01","n":"0907b","t":"現前供養不善相對歸依隨一"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0908a01","n":"0908a","t":"是又論但云五由意引成乎善"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0909a01","n":"0909a","t":"成唯識論演祕卷第五本沙門"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0909b01","n":"0909b","t":"所有法不應更思彼所緣境由"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0909c01","n":"0909c","t":"力互取所緣皆不違理問由相"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0910a01","n":"0910a","t":"也從二所依得身心稱問第六"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0910b01","n":"0910b","t":"非學非無學以三種為義釋曰"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0910c01","n":"0910c","t":"見既然邊見亦爾定隨有故故"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0911a01","n":"0911a","t":"有少分不死不滿如是名為離"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0911b01","n":"0911b","t":"記無記為義二無記善不善無"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0911c01","n":"0911c","t":"恚苦憂捨相應釋曰苦據五識"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0912a01","n":"0912a","t":"明知心王亦緣別相不爾如何"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0912b01","n":"0912b","t":"是三法聚集合故能有所觸又"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0912c01","n":"0912c","t":"擇諸法最極簡擇極簡擇法遍"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0913a01","n":"0913a","t":"破本師本師心所皆體是心惠"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0913b01","n":"0913b","t":"作智漏盡智通漏盡智力若說"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0913c01","n":"0913c","t":"法名厭非惠非無貪是心所法"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0914a01","n":"0914a","t":"虛空三諦所攝又依識如所立"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0915c01","n":"0915c","t":"他諸欲深生貪著名遍耽嗜於"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0916a01","n":"0916a","t":"為顯德故二文別按彼釋云不"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0916c01","n":"0916c","t":"攝故方名欲界云何言欲得有"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0917b01","n":"0917b","t":"為業損害自他為業能趣惡道"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0917c01","n":"0917c","t":"故此不說詳曰更助救云疏邪"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0918a01","n":"0918a","t":"行謂後有勝名為惑亂若由正"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0918c01","n":"0918c","t":"各成二十句見并本身見邊見"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0919a01","n":"0919a","t":"因過去果故問瑜伽第六云謂"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0919c01","n":"0919c","t":"云小樂等明皆有想故無想無"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0920a01","n":"0920a","t":"不明了故執我現非有想非無"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0920b01","n":"0920b","t":"答五十八中偏指謗因果等邪"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0920c01","n":"0920c","t":"者全常等攝非全常等皆邊見"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0921a01","n":"0921a","t":"舍論十九云於劣謂勝名為見"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0921b01","n":"0921b","t":"貪等六名之為總惡見開五名"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0921c01","n":"0921c","t":"尋文可悉問二論俱生為凡聖"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0922a01","n":"0922a","t":"及疏故不重云苦集由是因依"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0922b01","n":"0922b","t":"欲疑有喜受者欲似不得此中"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0922c01","n":"0922c","t":"記性數現行故非極損惱自他"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0923a01","n":"0923a","t":"漏道耶答後約菩薩今據二乘"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0923b01","n":"0923b","t":"斷者此即由伏不伏有殊何關"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0924a01","n":"0924a","t":"能親緣上地雜集釋云所言無"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0924b01","n":"0924b","t":"以觀之名壞念住按彼論云又"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0924c01","n":"0924c","t":"迷為據數總行別名別為約數"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0925a01","n":"0925a","t":"別後心緣義影像方生能詮所"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0925b01","n":"0925b","t":"事何非大過太過失存理盡焉"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0925c01","n":"0925c","t":"皆貪品類皆貪等流忿恨惱嫉"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0926a01","n":"0926a","t":"復別人諸衣服等所有利養或"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0926b01","n":"0926b","t":"不知如是欲界六欲天等展轉"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0926c01","n":"0926c","t":"諸善品令不轉故問於何等位"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0927a01","n":"0927a","t":"云隨煩惱自性者謂忿至惡作"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0927b01","n":"0927b","t":"除靜慮中間若定若生名有尋"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0927c01","n":"0927c","t":"識引未必盡理然將起上諸地"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0928a01","n":"0928a","t":"故若言迷者而因邪見之所引"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0928b01","n":"0928b","t":"彼相是故不立復次菩提分法"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0928c01","n":"0928c","t":"問若引本經經頌不云正思惟"},{"h":"https://cbetaonline.dila.edu.tw/zh/T43n1833_p0929a01","n":"0929a","t":"成唯識論演祕卷第六疏第七"},{"h":"ht