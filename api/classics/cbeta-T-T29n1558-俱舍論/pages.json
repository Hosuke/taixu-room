8_p0145c01","n":"0145c","t":"并上三近分總名除色想無色"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0146a01","n":"0146a","t":"二蘆束相依住故又說名色識"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0146b01","n":"0146b","t":"劫色相續斷後歿生下色從何"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0146c01","n":"0146c","t":"入無漏定者謂出世定愛不緣"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0147a01","n":"0147a","t":"二樂輕安攝故何理為證知是"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0147b01","n":"0147b","t":"失無違理失所以者何許說身"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0147c01","n":"0147c","t":"如餘部許我亦許然餘部云何"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0148a01","n":"0148a","t":"生靜慮從初有喜樂捨受及喜"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0148b01","n":"0148b","t":"染時捨退離自染得退離欲染"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0148c01","n":"0148c","t":"染生次下淨若於染淨能正了"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0149a01","n":"0149a","t":"至間超為成三洲利無學論曰"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0149b01","n":"0149b","t":"無為皆為境故有差別者無記"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0149c01","n":"0149c","t":"種以有勝德可愛味故同諸近"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0150a01","n":"0150a","t":"二無願無願三無相無相其相"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0150b01","n":"0150b","t":"諸加行善及無漏善得分別慧"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0150c01","n":"0150c","t":"治瞋此所治瞋貪所引故理實"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0151a01","n":"0151a","t":"說佛菩薩聲聞及獨覺等所受"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0151b01","n":"0151b","t":"論曰解脫有八一內有色想觀"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0151c01","n":"0151c","t":"故行者何緣修淨解脫為欲令"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0152a01","n":"0152a","t":"空識二淨無色為其自性各緣"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0152b01","n":"0152b","t":"佛正法有二謂教證為體有持"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0152c01","n":"0152c","t":"量故謂若我體別有實物如餘"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0153a01","n":"0153a","t":"者為薪令我了知火依薪義何"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0153b01","n":"0153b","t":"所言如依薪立火如是依蘊立"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0153c01","n":"0153c","t":"及明作意等緣為了因故應不"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0154a01","n":"0154a","t":"准此又立此為六識所識便違"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0154b01","n":"0154b","t":"羅亦自稱言我眼見色復隨世"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0154c01","n":"0154c","t":"能修空觀者亦都不可得經說"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0155a01","n":"0155a","t":"有色等如聚如流若爾世尊應"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0155b01","n":"0155b","t":"說所以者何亦未見故又取重"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0155c01","n":"0155c","t":"取捨諸蘊又汝所引祠者等生"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0156a01","n":"0156a","t":"不說命者都無亦觀問者阿世"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0156b01","n":"0156b","t":"滅不由功力咸得涅槃若記為"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0156c01","n":"0156c","t":"邊若執無我便墮斷邊前筏蹉"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0157a01","n":"0157a","t":"等不為依止差別愁憂散亂等"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0157b01","n":"0157b","t":"一類相續世共施設制怛羅牛"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0157c01","n":"0157c","t":"時說為燈行無別行者如是心"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0158a01","n":"0158a","t":"有異識生理定不然我與餘合"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0158b01","n":"0158b","t":"應信我體實有以有念等德句"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0158c01","n":"0158c","t":"世間於此事業若得自在名為"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0159a01","n":"0159a","t":"起花中生果功能故作是說若"},{"h":"https://cbetaonline.dila.edu.tw/zh/T29n1558_p0159b01","n":"0159b","t":"因後果生時瓤便色赤從此赤"}],"scheme":"cbeta","slug":"cbeta-T-T29n1558-俱舍論","source":"CBETA T29n1558 @ xml-p5 dbdea41","total":476,"unit":"T29 頁欄"}