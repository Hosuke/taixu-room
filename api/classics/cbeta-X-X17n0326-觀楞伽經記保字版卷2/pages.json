a.edu.tw/zh/X17n0326-2_p0361c01","n":"0361c","t":"有無二見以一切分別但分別"},{"h":"https://cbetaonline.dila.edu.tw/zh/X17n0326-2_p0362a01","n":"0362a","t":"畢竟不異堅執不捨是名非有"},{"h":"https://cbetaonline.dila.edu.tw/zh/X17n0326-2_p0362c01","n":"0362c","t":"自覺聖智究竟極至於此乃修"},{"h":"https://cbetaonline.dila.edu.tw/zh/X17n0326-2_p0363a01","n":"0363a","t":"三世一切諸佛歷代祖師一齊"},{"h":"https://cbetaonline.dila.edu.tw/zh/X17n0326-2_p0363b01","n":"0363b","t":"轉煩惱即菩提猶屬迷悟邊事"},{"h":"https://cbetaonline.dila.edu.tw/zh/X17n0326-2_p0363c01","n":"0363c","t":"記曰此釋空義也然空本是一"},{"h":"https://cbetaonline.dila.edu.tw/zh/X17n0326-2_p0364a01","n":"0364a","t":"法空也記曰此明五蘊緣生無"},{"h":"https://cbetaonline.dila.edu.tw/zh/X17n0326-2_p0364b01","n":"0364b","t":"善知彼法離惡見故以外道不"},{"h":"https://cbetaonline.dila.edu.tw/zh/X17n0326-2_p0364c01","n":"0364c","t":"即生而不生非一向不生也永"},{"h":"https://cbetaonline.dila.edu.tw/zh/X17n0326-2_p0365a01","n":"0365a","t":"涅槃無相違相斯則生死涅槃"},{"h":"https://cbetaonline.dila.edu.tw/zh/X17n0326-2_p0365b01","n":"0365b","t":"故下文結指離言記曰此結示"},{"h":"https://cbetaonline.dila.edu.tw/zh/X17n0326-2_p0365c01","n":"0365c","t":"以牛馬性結之臨文自當證知"}],"scheme":"cbeta","slug":"cbeta-X-X17n0326-觀楞伽經記保字版卷2","source":"CBETA X17n0326-2 @ xml-p5 dbdea41","total":66,"unit":"X17 頁欄"}