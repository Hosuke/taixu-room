1928_p0712a01","n":"0712a","t":"如為境即已成不思議假故非"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0712b01","n":"0712b","t":"損益而苦諍之境觀乖失而全"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0712c01","n":"0712c","t":"內體二字亦事理雙舉內即內"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0713a01","n":"0713a","t":"心為己外色心為他更用己他"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0713b01","n":"0713b","t":"此智行方能徹照性德而此智"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0713c01","n":"0713c","t":"單立知字解行足者乃玄文智"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0714a01","n":"0714a","t":"掌人何惑焉豈非逆修如病順"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0714b01","n":"0714b","t":"後結文三法相符雖似修二性"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0714c01","n":"0714c","t":"作一及無量故故知立則一多"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0715a01","n":"0715a","t":"既有厚薄之義故彊分三惑又"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0715b01","n":"0715b","t":"未顯故同名無明三千離障八"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0715c01","n":"0715c","t":"荊谿出時甚有人說也故知他"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0716a01","n":"0716a","t":"全無明功既非無作定能為障"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0716b01","n":"0716b","t":"二與有無俱有其義二之訓往"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0716c01","n":"0716c","t":"相常但相本流動今欲說常須"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0717a01","n":"0717a","t":"緣起性本圓常二初約性德直"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0717b01","n":"0717b","t":"先明淨用同在染心理具情迷"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0717c01","n":"0717c","t":"二初明三位本妙理等三位融"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0718a01","n":"0718a","t":"既解修成全是本具即知迷悟"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0718b01","n":"0718b","t":"無假又若自行唯修空中內觀"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0718c01","n":"0718c","t":"諸身尚即三業豈分故名不二"},{"h":"https://cbetaonline.dila.edu.tw/zh/T46n1928_p0719a01","n":"0719a","t":"中須順性三以成修德修性一"},{"h":"https://cbetaon