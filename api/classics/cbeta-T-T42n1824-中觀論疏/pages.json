4_p0146b01","n":"0146b","t":"既無所起亦無犢子佛陀成實"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0146c01","n":"0146c","t":"即斷心聖人便應無心若不斷"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0147a01","n":"0147a","t":"所有者此辨分別性空即是無"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0147b01","n":"0147b","t":"我樂淨亦四則生死有十六倒"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0147c01","n":"0147c","t":"第四句呵責若無有著法逐近"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0148a01","n":"0148a","t":"惱以生滅是虛妄為客煩惱無"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0148b01","n":"0148b","t":"生今此一章辨今無所滅不生"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0148c01","n":"0148c","t":"諦名出世間是故不應無世出"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0149a01","n":"0149a","t":"人所解故名聖諦又昔有凡夫"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0149b01","n":"0149b","t":"迷大小俱惑二諦論主明慧內"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0149c01","n":"0149c","t":"為著有者說空為著空者說有"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0150a01","n":"0150a","t":"明無佛初成道為提謂等說人"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0150b01","n":"0150b","t":"世諦是以興上邪難也問外人"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0150c01","n":"0150c","t":"以於凡聖皆是實故秤二於諦"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0151a01","n":"0151a","t":"諦故具三利以解第一義故生"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0151b01","n":"0151b","t":"義因此言欲顯無言若不言於"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0151c01","n":"0151c","t":"之等類云何而可度有人云此"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0152a01","n":"0152a","t":"眾因緣生法下第四引經證顯"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0152b01","n":"0152b","t":"不所所空不空故即中道次就"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0152c01","n":"0152c","t":"所說下此生第二段還有所得"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0153a01","n":"0153a","t":"受為無常所役名為行苦行苦"},{"h":"https://cbetaonline.dila.edu.tw/zh/T42n1824_p0153b01","n":"0153b","t":"問有二初領前無也究竟道下"},{"h":"https://cbetaonlin