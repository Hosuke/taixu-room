etaonline.dila.edu.tw/zh/T39n1795_p0567a01","n":"0567a","t":"未斷我愛前云終不成就者以"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0567b01","n":"0567b","t":"若於所求別生憎愛則不能入"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0567c01","n":"0567c","t":"於是普覺菩薩在大眾中即從"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0568a01","n":"0568a","t":"因求善知識正緣也善能知真"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0568b01","n":"0568b","t":"非不得飾非說理以誤凡下此"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0568c01","n":"0568c","t":"財錢帛妻子最親眷屬僕從對"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0569a01","n":"0569a","t":"彼圓覺性非作得故指體以破"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0569b01","n":"0569b","t":"息諸念生心恐非隨情慮失一"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0569c01","n":"0569c","t":"滅今滅惑住寂豈得相應況圓"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0570a01","n":"0570a","t":"行然別釋之中若師若徒病無"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0570b01","n":"0570b","t":"此憍慢也現逆順境遠離名逆"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0570c01","n":"0570c","t":"明自他憎愛尤顯異於前段前"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0571a01","n":"0571a","t":"爾時世尊欲重宣此義而說偈"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0571b01","n":"0571b","t":"大悲世尊為我等輩廣說淨覺"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0571c01","n":"0571c","t":"且赴如法華中官事當行之類"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0572a01","n":"0572a","t":"八發願今略唯二謂禮佛懺悔"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0572b01","n":"0572b","t":"遇善境界感應也或見佛像或"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0572c01","n":"0572c","t":"近比丘比丘尼而承事故即三"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0573a01","n":"0573a","t":"善男子此名菩薩示現安居過"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0573b01","n":"0573b","t":"例多覺發則同時已遍三誡邪"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0573c01","n":"0573c","t":"說十信凡夫覺滅相三賢覺異"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0574a01","n":"0574a","t":"三觀既修則萬行已圓故就此"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0574b01","n":"0574b","t":"三種淨觀隨學一事此觀不得"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0574c01","n":"0574c","t":"有此分都無人傳是不流流則"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0575a01","n":"0575a","t":"賢善首菩薩奉教歡喜及諸大"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0575b01","n":"0575b","t":"持之相也然答奉持之問者若"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0575c01","n":"0575c","t":"智也三以宿因反驗顯信經勝"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0576a01","n":"0576a","t":"種種不安乃至病等是惱身也"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0576b01","n":"0576b","t":"正明護持三鬼王眾爾時有大"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0576c01","n":"0576c","t":"圭峰定慧禪師遙稟清涼國師"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0577a01","n":"0577a","t":"疊理雖一味勢變多端差別義"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0577b01","n":"0577b","t":"宗天台多約止觀美則美矣且"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0577c01","n":"0577c","t":"申中書門下據伊本意豈盡顯"},{"h":"https://cbetaonline.dila.edu.tw/zh/T39n1795_p0578a01","n":"0578a","t":"喜極成悲伏蒙慈願弘深降斯"}],"scheme":"cbeta","slug":"cbeta-T-T39n1795-大方廣圓覺修多羅了義經略疏","source":"CBETA T39n1795 @ xml-p5 dbdea41","total":164,"unit":"T39 頁欄"}