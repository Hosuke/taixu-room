dila.edu.tw/zh/TX10n0007_p0210a01","n":"0210a","t":"離欲界一尺為離色界二尺為"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0211a01","n":"0211a","t":"此喻邊見煩惱依高大之身見"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0212a01","n":"0212a","t":"此明火焚宅壞總顯三界無常"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0214a01","n":"0214a","t":"此三頌頌正說三乘子四頌依"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0219a01","n":"0219a","t":"壬一觀根以說勿妄宣傳此言"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0220a01","n":"0220a","t":"佛僧二寶也斯法華經為深智"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0223a01","n":"0223a","t":"無所依託此釋得惡人果後福"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0226a01","n":"0226a","t":"薩心說法利他者可為說此明"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0227a01","n":"0227a","t":"文頗短故此次須菩提等領解"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0228a01","n":"0228a","t":"信解並彰此則本品須菩提等"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0230a01","n":"0230a","t":"同得涅槃復自信不能更作何"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0231a01","n":"0231a","t":"心必依佛法故所淨之國土即"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0232a01","n":"0232a","t":"此下說譬喻以生領解也壬二"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0234a01","n":"0234a","t":"行經歷遂至父城喻熏習既久"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0237a01","n":"0237a","t":"今因時機未熟教之不利爰隨"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0239a01","n":"0239a","t":"也此明便登果位名為兒者喻"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0240a01","n":"0240a","t":"汝便為不異者喻小乘大乘終"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0241a01","n":"0241a","t":"少時喻說大法之因緣已熟子"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0244a01","n":"0244a","t":"此亦有三義一我昔疑佛不教"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0245a01","n":"0245a","t":"壬一頌昔不悕喻癸一頌發心"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0246a01","n":"0246a","t":"念喻為佛法性身受用身之所"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0249a01","n":"0249a",