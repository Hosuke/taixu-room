a.edu.tw/zh/TX10n0007_p0433a01","n":"0433a","t":"此下釋修慧行為由定生慧也"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0434a01","n":"0434a","t":"無毀滅相故無生相無變異相"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0435a01","n":"0435a","t":"辛二重頌壬一頌住安樂行癸"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0436a01","n":"0436a","t":"指小乘之經律論三藏名字羅"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0437a01","n":"0437a","t":"畋獵射擊禽獸者為利殺害為"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0438a01","n":"0438a","t":"空子三頌中道境親近處此頌"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0440a01","n":"0440a","t":"語之過為說經時所應遠離智"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0441a01","n":"0441a","t":"此頌安坐淨身隨問說法此頌"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0442a01","n":"0442a","t":"諸佛三大阿僧祇劫修行之意"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0443a01","n":"0443a","t":"心無嫉恚下二頌頌比丘能離"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0444a01","n":"0444a","t":"法之流通不能利他而又害之"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0448a01","n":"0448a","t":"不能得大果以為樂不能得樂"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0449a01","n":"0449a","t":"然考其信佛之真際或視同仙"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0450a01","n":"0450a","t":"所有天人魔怨無能得其過失"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0452a01","n":"0452a","t":"尚不能為之宣說也珠在頂上"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0453a01","n":"0453a","t":"魔謂色受想行識之魔能覆障"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0458a01","n":"0458a","t":"夢中是所有諸法果相固無一"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0459a01","n":"0459a","t":"以諸菩薩從地中而升至虛空"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0462a01","n":"0462a","t":"涌出以升住於空故顯為來從"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0467a01","n":"0467a","t":"彌勒為等覺地菩薩為十地以"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0468a01","n":"0468a","t":"此頌菩薩來處謂從何處來及"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0469a01","n":"0469a","t":"即不止為六萬恆河沙之數是"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0472a01","n":"0472a","t":"示也信而有力斯為深信仍須"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0473a01","n":"0473a","t":"薩也此釋菩薩住行虛空中住"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0475a01","n":"0475a","t":"蓋化行之時短化眾之人多化"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0477a01","n":"0477a","t":"縱未了解然因信佛智通達無"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0479a01","n":"0479a","t":"今已釋竟而能行之人即此無"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0480a01","n":"0480a","t":"滿果即隨喜功德品與法師功"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0481a01","n":"0481a","t":"且分別告教聲聞辟支與諸菩"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0482a01","n":"0482a","t":"密妙密之意以佛究竟顯現圓"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0484a01","n":"0484a","t":"經所顯其量尤廣又報身佛之"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0486a01","n":"0486a","t":"如住宮出家八相成道之相共"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0488a01","n":"0488a","t":"實知見三界之相即是如實證"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0490a01","n":"0490a","t":"壽命即報身之慧命行菩薩道"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0492a01","n":"0492a","t":"壬二喻說癸一喻說常滅全喻"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0493a01","n":"0493a","t":"多此為慈矜起化喻此土已度"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0496a01","n":"0496a","t":"虛妄然亦無有能說佛過失者"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0498a01","n":"0498a","t":"此五頌頌報身化身二土之相"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0500a01","n":"0500a","t":"本品經文約分為二初一長行"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0506a01","n":"0506a","t":"者所不能及故不復有退轉之"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0508a01","n":"0508a","t":"此五頌半中初四頌頌能信之"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0511a01","n":"0511a","t":"造已供養自則為以佛句起至"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0514a01","n":"0514a","t":"樹即棕樹此三頌頌兼行六度"}],"scheme":"cbeta","slug":"cbeta-太虛-第七編-法華講演錄上","source":"CBETA TX10n0007 @ xml-p5 dbdea41","total":513,"unit":"TX10 頁欄"}