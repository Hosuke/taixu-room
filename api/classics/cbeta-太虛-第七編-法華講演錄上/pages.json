.dila.edu.tw/zh/TX10n0007_p0138a01","n":"0138a","t":"義一乘之體即真如法性一切"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0139a01","n":"0139a","t":"如來演說唯一佛乘之意以用"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0141a01","n":"0141a","t":"惡道之惡法如於無十惡之人"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0142a01","n":"0142a","t":"之二乘三乘也辛二破四疑壬"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0143a01","n":"0143a","t":"邪見不正見而於一切道德不"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0144a01","n":"0144a","t":"羅漢實得辟支佛者對於佛乘"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0145a01","n":"0145a","t":"此謂諸佛必無妄語也佛意諸"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0146a01","n":"0146a","t":"即卑劣慢也戒為出生死海之"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0147a01","n":"0147a","t":"十二部經之次第一曰契經二"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0149a01","n":"0149a","t":"槃化城等名悉是引導之假名"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0150a01","n":"0150a","t":"此頌悟佛知見佛證大乘平等"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0152a01","n":"0152a","t":"癸六頌依法式顯子一總頌此"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0157a01","n":"0157a","t":"此頌我今亦由是法式丑二頌"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0159a01","n":"0159a","t":"諸果小法即教菩薩法亦即佛"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0162a01","n":"0162a","t":"之義七譬喻者譬喻品中之火"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0163a01","n":"0163a","t":"鶖子領解己一長行此釋聞法"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0164a01","n":"0164a","t":"如是權法而所見者則為諸菩"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0165a01","n":"0165a","t":"於大乘正可由此以趨於一乘"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0166a01","n":"0166a","t":"此頌自歎證於小智失於大法"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0168a01","n":"0168a","t":"生死中故曰邪見舍利弗原從"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0170a01","n":"0170a","t":"此明授因記正法即大乘法亦"},{"h":"https://cbetaonline.dila.edu.tw/zh/TX10n0007_p0172a01","n":"0172a"